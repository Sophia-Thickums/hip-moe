+// fork: uncached load. CUDA has __ldcv; HIP has no equivalent, and a volatile read
+// is how an uncached load is expressed there. Both compile to a load that does not
+// serve a stale line of a reused pinned block.
+#if defined(GGML_USE_HIP) && defined(__HIP_PLATFORM_AMD__)
+// clang's non-temporal load is the AMD expression of "do not serve a cached line".
+// A volatile read has no copy constructor for HIP's vector types, and the builtin
+// rejects them too, so the 16-byte path is four scalar non-temporal loads.
+static __device__ __forceinline__ uint8_t ggml_ldcv(const uint8_t * p) {
+    return __builtin_nontemporal_load(p);
+}
+static __device__ __forceinline__ uint4 ggml_ldcv(const uint4 * p) {
+    const unsigned int * q = reinterpret_cast<const unsigned int *>(p);
+    return make_uint4(__builtin_nontemporal_load(q + 0), __builtin_nontemporal_load(q + 1),
+                      __builtin_nontemporal_load(q + 2), __builtin_nontemporal_load(q + 3));
+}
+#else
+template <typename T>
+static __device__ __forceinline__ T ggml_ldcv(const T * p) { return __ldcv(p); }
+#endif
